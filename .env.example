# 信服AI工具箱环境变量配置
# 复制此文件为 .env 并填入实际值

# ===== 数据库 =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=xinfu_ai
POSTGRES_USER=xinfu
POSTGRES_PASSWORD=changeme_pg_password

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=changeme_redis_password
REDIS_DB=0

# ===== JWT =====
JWT_SECRET_KEY=changeme_jwt_secret_key_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== 企业微信 =====
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_CALLBACK_URL=

# ===== 管理路径 =====
ADMIN_PATH_SALT=

# ===== CORS =====
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ===== 应用配置 =====
APP_NAME=信服AI工具箱
APP_VERSION=1.0.0
DEBUG=true

# ===== API Key 加密 =====
ENCRYPTION_KEY=changeme_32_char_encryption_key!!

# ===== Railway =====
DATABASE_URL=
REDIS_URL=
